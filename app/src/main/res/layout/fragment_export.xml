<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="数据导出"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnExportToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="导出今日数据"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExportMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="导出本月数据"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExportAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="导出全部数据"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Excel 文件将保存到手机「下载」目录下的 FinanceManager 文件夹中，可在系统文件管理器的「下载」分类中查看"
            android:textSize="13sp"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvExportResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#4ECDC4" />
    </LinearLayout>
</ScrollView>